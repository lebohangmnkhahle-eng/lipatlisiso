+    def rule_5_possessive_ya_hao(self, text: str) -> Tuple[str, bool]:
+        """
+        Rule 5: Possessive marker "ya <poss>" -> "ea <poss>"
+        Applies to common possessives and uses word boundaries to avoid mid-word matches.
+        """
+        # Matches 'ya hao', 'ya rona', 'ya bona' with case handling
+        pattern = re.compile(r'\b[Yy]a\s+(hao|rona|bona)\b', flags=re.UNICODE)
+        def repl(m):
+            poss = m.group(1)
+            prefix = m.group(0).split()[0]
+            if prefix and prefix[0].isupper():
